{
  "openapi": "3.0.0",
  "info": {
    "title": "Auth API for Studio",
    "version": "1.0.0",
    "description": "Ендпоінти для роботи з авторизацією та управлінням контенту в системі Studio"
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Реєстрація нового користувача",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "John Doe" },
                  "email": { "type": "string", "example": "john@example.com" },
                  "password": { "type": "string", "example": "qwerty123" }
                },
                "required": ["name", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Користувач успішно створений",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Помилка валідації",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Логін користувача",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "john@example.com" },
                  "password": { "type": "string", "example": "qwerty123" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Логін успішний, повертає токен",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string", "example": "eyJhbGciOi..." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Невірний email або пароль",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Вихід користувача",
        "responses": {
          "200": {
            "description": "Успішний вихід",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Logged out successfully" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Отримати поточного користувача",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "example": "Bearer <token>" }
          }
        ],
        "responses": {
          "200": {
            "description": "Поточний користувач",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": {
            "description": "Невалідний або відсутній токен",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/users/search": {
      "get": {
        "tags": ["Users"],
        "summary": "Пошук користувачів з фільтрацією, пагінацією та сортуванням",
        "parameters": [
          { "name": "name", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "email", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "role", "in": "query", "schema": { "type": "string", "enum": ["USER","EDITOR","ADMIN"] }, "required": false },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "required": false },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 }, "required": false },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "createdAt" }, "required": false },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc","desc"], "default": "desc" }, "required": false }
        ],
        "responses": {
          "200": {
            "description": "Список користувачів",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserListResponse" }
              }
            }
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Отримати користувача за ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Користувач",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Оновити користувача",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Оновлений користувач",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/users/{id}/role": {
      "patch": {
        "tags": ["Users"],
        "summary": "Змінити роль користувача",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangeUserRoleInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Роль користувача оновлена",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/articles": {
      "post": {
        "tags": ["Articles"],
        "summary": "Створити нову статтю",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateArticleInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Стаття створена",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Article" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/articles/search": {
      "get": {
        "tags": ["Articles"],
        "summary": "Пошук статей з фільтрацією, пагінацією та сортуванням",
        "parameters": [
          { "name": "title", "in": "query", "schema": { "type": "string" }, "required": false },
          { "name": "lang", "in": "query", "schema": { "type": "string", "enum": ["UK","EN","PL","LT","RO"] }, "required": false },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" }, "required": false },
          { "name": "subcategoryId", "in": "query", "schema": { "type": "integer" }, "required": false },
          { "name": "published", "in": "query", "schema": { "type": "boolean" }, "required": false },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "required": false },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 }, "required": false },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "createdAt" }, "required": false },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc","desc"], "default": "desc" }, "required": false }
        ],
        "responses": {
          "200": {
            "description": "Список статей із фільтрацією",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleListResponse" } } }
          }
        }
      }
    },
    "/api/articles/{id}": {
      "get": {
        "tags": ["Articles"],
        "summary": "Отримати статтю за ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Стаття", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Article" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Articles"],
        "summary": "Оновити статтю",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateArticleInput" } } } },
        "responses": {
          "200": { "description": "Оновлена стаття", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Article" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Articles"],
        "summary": "Видалити статтю",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Стаття видалена" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/articles/publish": {
      "post": {
        "tags": ["Articles"],
        "summary": "Опублікувати статтю",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublishArticleInput" } } } },
        "responses": {
          "200": { "description": "Стаття опублікована", "content": { "application/json": { "schema": { "type": "object", "properties": { "message": { "type": "string", "example": "Article published" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/categories": {
      "post": {
        "tags": ["Categories"],
        "summary": "Створити нову категорію",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCategoryInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Категорія створена",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Category" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/categories/search": {
      "get": {
        "tags": ["Categories"],
        "summary": "Пошук категорій з фільтрацією, пагінацією та сортуванням",
        "parameters": [
          { "name": "name", "in": "query", "schema": { "type": "string" }, "description": "Фільтр за назвою категорії", "required": false },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Номер сторінки", "required": false },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 }, "description": "Кількість категорій на сторінці", "required": false },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "name" }, "description": "Поле для сортування", "required": false },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc","desc"], "default": "asc" }, "description": "Напрямок сортування", "required": false }
        ],
        "responses": {
          "200": {
            "description": "Список категорій із фільтрацією",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CategoryListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/categories/{id}": {
      "get": {
        "tags": ["Categories"],
        "summary": "Отримати категорію за id",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Категорія", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Categories"],
        "summary": "Оновити категорію",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateCategoryInput" } } }
        },
        "responses": {
          "200": { "description": "Категорія оновлена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "Видалити категорію",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Категорія видалена" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/subcategories": {
      "post": {
        "tags": ["Subcategories"],
        "summary": "Створити підкатегорію",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSubcategoryInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Підкатегорія створена",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Subcategory" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/subcategories/search": {
      "get": {
        "tags": ["Subcategories"],
        "summary": "Пошук підкатегорій з фільтрацією, пагінацією та сортуванням",
        "parameters": [
          { "name": "name", "in": "query", "schema": { "type": "string" }, "description": "Фільтр за назвою підкатегорії", "required": false },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" }, "description": "Фільтр по категорії", "required": false },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Номер сторінки", "required": false },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 }, "description": "Кількість підкатегорій на сторінці", "required": false },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "name" }, "description": "Поле для сортування", "required": false },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc","desc"], "default": "asc" }, "description": "Напрямок сортування", "required": false }
        ],
        "responses": {
          "200": {
            "description": "Список підкатегорій із фільтрацією",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubcategoryListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/subcategories/{id}": {
      "get": {
        "tags": ["Subcategories"],
        "summary": "Отримати підкатегорію за id",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Підкатегорія", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Subcategory" } } } } }
      },
      "patch": {
        "tags": ["Subcategories"],
        "summary": "Оновити підкатегорію",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateSubcategoryInput" } } } },
        "responses": { "200": { "description": "Підкатегорія оновлена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Subcategory" } } } } }
      },
      "delete": {
        "tags": ["Subcategories"],
        "summary": "Видалити підкатегорію",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Підкатегорія видалена" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/tags": {
      "post": {
        "tags": ["Tags"],
        "summary": "Створити тег",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTagInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Тег створено",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/tags/search": {
      "get": {
        "tags": ["Tags"],
        "summary": "Пошук тегів з фільтрацією, пагінацією та сортуванням",
        "parameters": [
          { "name": "name", "in": "query", "schema": { "type": "string" }, "description": "Фільтр за назвою тегу", "required": false },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Номер сторінки", "required": false },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 }, "description": "Кількість тегів на сторінці", "required": false },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "default": "name" }, "description": "Поле для сортування", "required": false },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc","desc"], "default": "asc" }, "description": "Напрямок сортування", "required": false }
        ],
        "responses": {
          "200": {
            "description": "Список тегів із фільтрацією",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/tags/{id}": {
      "get": {
        "tags": ["Tags"],
        "summary": "Отримати тег за id",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Тег", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tag" } } } } }
      },
      "patch": {
        "tags": ["Tags"],
        "summary": "Оновити тег",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTagInput" } } } },
        "responses": { "200": { "description": "Тег оновлено", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tag" } } } } }
      },
      "delete": {
        "tags": ["Tags"],
        "summary": "Видалити тег",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Тег видалено" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/media": {
      "get": {
        "tags": ["Media"],
        "summary": "Отримати список всіх медіа",
        "responses": {
          "200": {
            "description": "Список медіа",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MediaListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Media"],
        "summary": "Завантажити файл",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                },
                "required": ["file"]
