generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  EDITOR
  ADMIN
  OWNER
}

enum ArticleGradient {
  NONE
  GRADIENT_1
  GRADIENT_2
}

enum ArticleLang {
  UK
  EN
  PL
  LT
  RO
}

enum ArticleSlider {
  NONE
  SLIDER_1
  SLIDER_2
}

enum ProjectLang {
  UK
  EN
  PL
  LT
  RO
  MK
}

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  TWITTER
  TIKTOK
}

enum PartnerRole {
  PARTNER
  MEMBER
  DONOR
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

model Partner {
  id          Int           @id @default(autoincrement())
  name        String
  email       String        @unique
  role        PartnerRole
  status      PartnerStatus @default(PENDING)
  description String?       @db.Text
  link        String?

  imageId Int?
  image   Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  published   Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  avatarId Int?
  avatar   Media? @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  studioProjects StudioProject[]
  media          Media[]         @relation("UserMedia")
  articles       Article[]
}

model Article {
  id Int @id @default(autoincrement())

  slug  String      @unique
  title String
  lang  ArticleLang

  body Json

  authorName String

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  authorAvatarId Int?
  authorAvatar   Media? @relation("ArticleAuthorAvatar", fields: [authorAvatarId], references: [id], onDelete: SetNull)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  imageId Int?
  image   Media? @relation(fields: [imageId], references: [id])

  slider ArticleSlider @default(NONE)
  gradient ArticleGradient @default(NONE)
  subcategories Subcategory[] @relation("ArticleSubcategories")

  tags Tag[]

  published   Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, published])
}

model SocialLink {
  id       Int            @id @default(autoincrement())
  platform SocialPlatform @unique

  projects ProjectSocialLink[]

  createdAt DateTime @default(now())
}

model ProjectSocialLink {
  projectId Int
  socialId  Int
  url       String

  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  social  SocialLink    @relation(fields: [socialId], references: [id], onDelete: Cascade)

  @@id([projectId, socialId])
}

model StudioProject {
  id Int @id @default(autoincrement())

  lang ProjectLang @default(UK)
  parentId Int?
  parent StudioProject? @relation("ProjectHierarchy", fields: [parentId], references: [id])
  children StudioProject[] @relation("ProjectHierarchy")

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId Int? @unique
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  title       String
  title_en    String?
  title_pl    String?
  title_lt    String?
  title_ro    String?
  body        Json?
  body_en     Json?
  body_pl     Json?
  body_lt     Json?
  body_ro     Json?
  description String?
  imageId     Int?
  image       Media? @relation("ProjectImage", fields: [imageId], references: [id])
  logoId      Int?
  logo        Media? @relation("ProjectLogo", fields: [logoId], references: [id])

  socialLinks ProjectSocialLink[]

  presentationUrl            String?
  presentationTitle          String?
  presentationDescription    String? @db.Text

  presentationUrl_uk         String?
  presentationTitle_uk       String?
  presentationDescription_uk String? @db.Text

  authorId Int?
  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  locationId Int? @unique
  location   Location? @relation(name: "StudioProjectLocation", fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  published   Boolean   @default(false)
  publishedAt DateTime?
}

model Location {
  id Int @id @default(autoincrement())
  name String
  url  String @unique
  coordinates Json?
  description String?

  publishedAt DateTime?

  project StudioProject? @relation(name: "StudioProjectLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  studioProjects StudioProject[] 
  articles      Article[]
  subcategories Subcategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Subcategory {
  id   Int    @id @default(autoincrement())
  name String
  slug String

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  articles Article[] @relation("ArticleSubcategories")
  project StudioProject? 

  @@unique([slug, categoryId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Media {
  id       Int    @id @default(autoincrement())
  url      String
  filename String
  mimeType String
  size     Int

  uploaderId Int
  uploader   User @relation("UserMedia", fields: [uploaderId], references: [id], onDelete: Cascade)

  createdAt             DateTime          @default(now())
  articles              Article[]
  projects              StudioProject[]   @relation("ProjectImage")
  projectLogos          StudioProject[]   @relation("ProjectLogo")
  partners              Partner[]
  userAvatars           User[]            @relation("UserAvatar")
  articleAuthorAvatars  Article[]         @relation("ArticleAuthorAvatar")
}
